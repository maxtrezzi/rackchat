<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.maxtrezzi</groupId>
  <artifactId>rackchat-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>RackChat Backend</name>
  <description>Backend for RackChat: a Javalin API in front of a modelrack4j registry.</description>
  <url>https://github.com/maxtrezzi/rackchat</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>maxtrezzi</id>
      <name>maxtrezzi</name>
      <url>https://github.com/maxtrezzi</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/maxtrezzi/rackchat.git</connection>
    <developerConnection>scm:git:git@github.com:maxtrezzi/rackchat.git</developerConnection>
    <url>https://github.com/maxtrezzi/rackchat</url>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <javalin.version>7.2.3</javalin.version>
    <modelrack4j.version>0.2.0</modelrack4j.version>
    <jackson.version>2.22.1</jackson.version>
    <slf4j.version>2.0.17</slf4j.version>
    <junit.version>5.14.4</junit.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.maxtrezzi</groupId>
        <artifactId>modelrack4j-bom</artifactId>
        <version>${modelrack4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
      <version>${javalin.version}</version>
    </dependency>

    <!-- modelrack4j: the connection layer (ADR-0004). Versions come from its BOM. -->
    <dependency>
      <groupId>io.github.maxtrezzi</groupId>
      <artifactId>modelrack4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.maxtrezzi</groupId>
      <artifactId>modelrack4j-provider-openai</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.github.maxtrezzi</groupId>
      <artifactId>modelrack4j-provider-anthropic</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.github.maxtrezzi</groupId>
      <artifactId>modelrack4j-provider-gemini</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.github.maxtrezzi</groupId>
      <artifactId>modelrack4j-provider-glm</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!--
      Javalin serialises ctx.json(...) and non-String SSE payloads through Jackson, which it
      finds reflectively rather than declaring. langchain4j-core happens to bring it, but
      relying on someone else's transitive dependency for something we use is how a build
      breaks on an unrelated bump - so declare it, at the version that tree already resolves.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
